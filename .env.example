# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — VEL 0.1 SISTEMA COMERCIAL Y SUSCRIPCIONES (CLOUDFLARE)
# ==============================================================================
# IMPORTANTE: Estos valores deben configurarse en el panel de variables de entorno
# del proyecto en Cloudflare Pages (Workers & Pages > Settings > Variables and Secrets).
# NUNCA ingresar claves privadas reales en el código del navegador, Blogger ni repositorios.

# ------------------------------------------------------------------------------
# 1. MERCADO PAGO (Secretos exclusivamente de servidor / Cloudflare Pages Functions)
# ------------------------------------------------------------------------------
# Access Token privado del vendedor en Mercado Pago (configurar como Secret en Cloudflare Pages)
MP_ACCESS_TOKEN=""

# Clave secreta para validación de firma HMAC SHA-256 en Webhooks x-signature (configurar como Secret)
MP_WEBHOOK_SECRET=""

# Tolerancia máxima de antigüedad (en segundos) del timestamp ts en x-signature (opcional; predeterminado: 172800 = 48 horas)
MP_WEBHOOK_MAX_AGE_SECONDS=""

# Secreto dedicado opcional para firmar pases temporales vel_pass (si no se define, deriva de MP_WEBHOOK_SECRET / clave de servicio)
VEL_ACTIVATION_SECRET=""

# ------------------------------------------------------------------------------
# 2. FIREBASE AUTHENTICATION & FIRESTORE REST API (Servidor Cloudflare)
# ------------------------------------------------------------------------------
# Identificador del proyecto Firebase (ej. proyecto-vel)
FIREBASE_PROJECT_ID=""

# Credencial JSON de cuenta de servicio o codificada en Base64 (configurar como Secret en Cloudflare Pages)
FIREBASE_SERVICE_ACCOUNT=""

# Alternativa separada a FIREBASE_SERVICE_ACCOUNT si no se usa JSON completo:
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 3. URLS Y CORS DEL PORTAL (Opcionales)
# ------------------------------------------------------------------------------
# URL base pública del sitio en Cloudflare Pages (ej. https://proyecto-vel.pages.dev)
APP_BASE_URL=""

# URL de retorno al portal VEL tras completar/cancelar el pago en Mercado Pago
VEL_PORTAL_RETURN_URL=""

# Origen adicional permitido por CORS además de https://proyecto-vel.blogspot.com
BLOGGER_ORIGIN=""

# ------------------------------------------------------------------------------
# 4. RELAY WEBSOCKET (Servidor Node.js persistente en Render)
# ------------------------------------------------------------------------------
# URL pública segura (wss://...) del servidor Relay desplegado (configurar en Cloudflare Pages)
VEL_RELAY_WSS_URL=""

# Alternativa pública para build de Vite (opcional si se usa /api/relay-config con VEL_RELAY_WSS_URL)
VITE_VEL_RELAY_WSS_URL=""

# Puerto de escucha del proceso standalone server-vel/relay-server.ts (Render inyecta PORT)
RELAY_PORT="8080"

# Lista separada por comas de orígenes HTTPS permitidos en Render (ej: https://proyecto-vel.pages.dev)
RELAY_ALLOWED_ORIGINS=""
